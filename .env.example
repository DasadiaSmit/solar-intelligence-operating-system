# Solar Intelligence OS — copy to .env.local for local overrides.
# No credentials are required for deterministic sample mode.

# Provider policy: auto | live | sample
SOLAR_PROVIDER_MODE=auto
# Auto mode may return explicitly-labelled simulation data only after a live
# provider fails. Set false to fail closed instead.
SOLAR_ALLOW_SIMULATED_FALLBACK=true

# Public, no-key provider endpoints. Override only for an approved compatible
# proxy or local test double; production endpoints must use HTTPS.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_BASE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_MODEL=best_match
OPEN_METEO_REANALYSIS_MODEL=era5
PVGIS_BASE_URL=https://re.jrc.ec.europa.eu/api/v5_3/tmy

# Bounded request policy.
PROVIDER_TIMEOUT_MS=7000
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_BACKOFF_BASE_MS=220
PROVIDER_CACHE_TTL_SECONDS=900

# Scheduled refresh is sample by default. Change to open-meteo only after
# reviewing provider capacity, attribution and operational policy.
SOLAR_INGESTION_PROVIDER=sample
SOLAR_DEFAULT_LATITUDE=51.5074
SOLAR_DEFAULT_LONGITUDE=-0.1278

# Hosted Cloudflare bindings are injected from .openai/hosting.json:
# DB          — D1 relational metadata
# SNAPSHOTS   — R2 immutable raw/canonical dataset snapshots
# Never place binding credentials or API keys in this file.
