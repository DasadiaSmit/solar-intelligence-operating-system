import { readFile,writeFile,mkdir,readdir } from 'node:fs/promises';
import { resolve,join } from 'node:path';
import { createHash } from 'node:crypto';
import { gzipSync,gunzipSync } from 'node:zlib';
import { execFileSync } from 'node:child_process';
import assert from 'node:assert/strict';
import { createFrozenBundle,validateFrozenBundle } from '../../lib/research/frozen-bundle.js';
import { buildAnnualResearchStudyFromArchive,buildResearchPredictionEvidence } from '../../lib/research/annual-study.js';
import { buildRepresentativeAudit } from '../../lib/research/representative-audit.js';
import { buildDecisionReport } from '../../lib/research/decision-report.js';
import { assertAssessmentSources } from '../../lib/research/assessment-source.js';
import type { HistoricalWeatherArchive } from '../../lib/research/historical-weather.js';
import type { SystemConfig } from '../../lib/contracts/index.js';

const [inputArg,outputArg]=process.argv.slice(2);
if(!inputArg||!outputArg)throw new Error('Usage: run-assessment-audit.mts INPUT_BASELINE_DIRECTORY NEW_OUTPUT_DIRECTORY');
const input=resolve(inputArg),output=resolve(outputArg);
const sourceCommit=execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim();
const diff=execFileSync('git',['diff','HEAD'],{encoding:'utf8'});
const untracked=execFileSync('git',['ls-files','--others','--exclude-standard'],{encoding:'utf8'}).trim();
if(diff||untracked)throw new Error('Analysis must be committed before results are issued; no output has been written.');
const hash=(b:Buffer|string)=>createHash('sha256').update(b).digest('hex');
const manifest=JSON.parse(await readFile(join(input,'manifest.json'),'utf8'));
const compressed=await readFile(join(input,'archive.json.gz'));
assert.equal(hash(compressed),manifest.archiveGzipSha256,'Compressed input integrity');
const archiveBytes=gunzipSync(compressed);assert.equal(hash(archiveBytes),manifest.archiveSha256,'Archive input integrity');
const configBytes=await readFile(join(input,'configuration.json'));assert.equal(hash(configBytes),manifest.configurationSha256,'Configuration integrity');
const protocolBytes=await readFile(join(input,'protocol.json'));assert.equal(hash(protocolBytes),manifest.protocolSha256,'Protocol integrity');
const baselineBytes=await readFile(join(input,'baseline-study.json'));assert.equal(hash(baselineBytes),manifest.baselineStudySha256,'Baseline result integrity');
const protocol=JSON.parse(protocolBytes.toString());
assert.equal(protocol.id,'short-record-decision-audit-01');assert.equal(protocol.version,'1.0.0');
const config=JSON.parse(configBytes.toString()) as SystemConfig;
assert.equal(config.array.capacityKwDc,protocol.arrayCandidates.capacityKwDc);assert.equal(config.array.dcAcRatio,protocol.arrayCandidates.dcAcRatio);
const archive=JSON.parse(archiveBytes.toString()) as HistoricalWeatherArchive;
assertAssessmentSources(manifest,archive);
// Replay is intentionally unable to call the network, even if a future helper changes.
globalThis.fetch=async()=>{throw new Error('Network disabled during frozen research replay');};
const frozen=await createFrozenBundle(config,archive,{createdAtUtc:manifest.startedAt,sourceCommit:manifest.sourceCommit,purpose:`Protocol ${manifest.protocolSha256}; retrospective assessment baseline`});
const validated=await validateFrozenBundle(JSON.parse(JSON.stringify(frozen)));
const replay=await buildAnnualResearchStudyFromArchive(validated.config,validated.archive,new Date(manifest.startedAt));
assert.deepEqual(replay,JSON.parse(baselineBytes.toString()),'Default annual study must reproduce the pre-change baseline exactly');
const predictionEvidence=await buildResearchPredictionEvidence(config,archive);
assert.deepEqual(predictionEvidence.validation,replay.validation,'Exported predictions must share the annual-study metric path');
const candidates=protocol.arrayCandidates.tiltDeg.flatMap((tiltDeg:number)=>protocol.arrayCandidates.azimuthDeg.map((azimuthDeg:number)=>({id:`tilt-${tiltDeg}_azimuth-${azimuthDeg}`,tiltDeg,azimuthDeg})));
const audit=buildRepresentativeAudit(config,archive,candidates,protocol.tieToleranceKWh);
assert.equal(audit.variants[0].annualKWh,replay.annualEstimate.centralEstimateKWh,'Audit default must reconcile to baseline');
const report=buildDecisionReport(replay,audit);
await mkdir(output,{recursive:false});
const write=(name:string,data:string|Buffer)=>writeFile(join(output,name),data,{flag:'wx'});
const json=(name:string,data:unknown)=>write(name,JSON.stringify(data,null,2)+'\n');
const csv=(columns:string[],rows:Record<string,unknown>[])=>[columns.join(','),...rows.map(r=>columns.map(c=>JSON.stringify(r[c]??'')).join(','))].join('\n')+'\n';
await write('frozen-bundle.json.gz',gzipSync(JSON.stringify(frozen)));
await write('protocol.json',protocolBytes);await json('baseline-study-replay.json',replay);await json('audit.json',audit);
await write('REPORT.md',report);
await write('predictions-2025.csv',csv(Object.keys(predictionEvidence.predictions[0]),predictionEvidence.predictions.map(r=>({...r}))));
await json('prediction-evidence.json',predictionEvidence);
await write('model-metrics.csv',csv(['model','task','target','mae','rmse','bias','annualErrorPct','coveragePct'],replay.validation.modelEvidence.map(m=>({model:m.id,task:m.task,target:m.target,mae:m.metrics?.mae,rmse:m.metrics?.rmse,bias:m.metrics?.bias,annualErrorPct:m.annualErrorPct,coveragePct:m.metrics?.intervalCoveragePct}))));
const energyRows=[...audit.historical.map(h=>({case:String(h.year),...h})),...audit.variants.map(v=>({case:v.id,...v}))].flatMap(row=>[{case:row.case,month:'annual',kWh:row.annualKWh},...row.monthlyKWh.map((kWh,month)=>({case:row.case,month:month+1,kWh}))]);
await write('annual-monthly.csv',csv(['case','month','kWh'],energyRows));
await write('month-candidate-scores.csv',csv(['variant','month','year','distributionScore','persistencePenalty','continuityPenalty','totalScore','selected','selectionMargin'],audit.variants.flatMap(v=>v.diagnostics.candidates.map(c=>({variant:v.id,...c,selectionMargin:v.diagnostics.selectionMargins[c.month-1].margin})))));
const arrayRows=[...audit.historicalCases,...audit.variantCases].flatMap(c=>c.rows.flatMap((row,index)=>[{case:c.id,candidate:candidates[index].id,month:'annual',kWh:row.annualKWh},...row.monthlyKWh.map((kWh,month)=>({case:c.id,candidate:candidates[index].id,month:month+1,kWh}))]));
await write('array-comparison.csv',csv(['case','candidate','month','kWh'],arrayRows));
await json('reproduction.json',{baselineStudyId:replay.studyId,baselineSourceCommit:manifest.sourceCommit,analysisSourceCommit:sourceCommit,protocolSha256:manifest.protocolSha256,fullBaselineEquality:true,defaultAuditEnergyEquality:true,predictionMetricPathEquality:true,networkDisabled:true,target:'physics-derived-generation',evaluationStatus:predictionEvidence.evaluationStatus});
const files=[];for(const name of (await readdir(output)).sort()){const bytes=await readFile(join(output,name));files.push({path:name,sha256:hash(bytes),bytes:bytes.length});}
await json('manifest.json',{schema:'sios-assessment-evidence-1',generatedAtUtc:new Date().toISOString(),sourceCommit,protocolSha256:manifest.protocolSha256,files});
console.log(JSON.stringify({output,studyId:replay.studyId,annualKWh:audit.variants[0].annualKWh,nominal: audit.choice.nominalWinnerIds,robust:audit.choice.robustWinnerIds,worstRegretReductionKWh:audit.choice.worstRegretReductionKWh,files:files.length}));
