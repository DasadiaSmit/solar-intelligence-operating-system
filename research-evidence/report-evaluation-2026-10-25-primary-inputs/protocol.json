{
  "id": "report-information-evaluation-03",
  "version": "1.0.0",
  "fixedDate": "2026-10-25",
  "question": "Which decision facts are stated correctly, merely derivable or unavailable in nominal summaries, equal-information tables and the existing evidence report; how safely are incomplete/conflicting inputs handled?",
  "comparisonBaselineCommit": "0dde63d2643514127e4383bfd6da9e69f91a03b4",
  "design": "Deterministic known-answer functional benchmark. Cases and answers are designed with knowledge of the existing code; this is neither blinded nor a human decision study.",
  "conditions": [
    {
      "id": "point",
      "definition": "Nominal yields and all nominal winners, common provenance/scope and scenario-count context. No unsupported robust or uncertainty claim."
    },
    {
      "id": "tables",
      "definition": "Same raw nominal, four-scenario and omission evidence as the full report. Tables without derived decision narrative. Arithmetic extraction allowed in separately reported derivable coverage."
    },
    {
      "id": "evidence-v1",
      "definition": "Existing buildDecisionReport via normal compareEnergyChoices producer for valid inputs. Renderer source unchanged. Actual generated Markdown assessed; complete audit adapters are synthetic test objects."
    }
  ],
  "primaryCases": [
    "C01",
    "C02",
    "C03",
    "C04",
    "C05",
    "C06"
  ],
  "incompleteCases": [
    "C07",
    "C08"
  ],
  "directRendererStressCases": [
    "S01"
  ],
  "questions": [
    {
      "id": "Q1",
      "fact": "Nominal winner set with all ties and maximum nominal energy."
    },
    {
      "id": "Q2",
      "fact": "Minimax-regret winner set with all ties and minimum worst regret."
    },
    {
      "id": "Q3",
      "fact": "Omission sensitivity minimum/maximum and correct sensitivity, not probability, classification."
    },
    {
      "id": "Q4",
      "fact": "Count of option pairs reversing order across historical scenarios."
    },
    {
      "id": "Q5",
      "fact": "Worst-regret reduction minimum/maximum across all nominal ties, including explicit zero benefit."
    },
    {
      "id": "Q6",
      "fact": "Nominal yield sacrificed by every robust winner; do not infer sacrifice from regret gain."
    },
    {
      "id": "Q7",
      "fact": "Available versus expected historical scenario count (4), with missing cells identified when relevant."
    },
    {
      "id": "Q8",
      "fact": "Finite-case/modelled-evidence scope; no measured output, future probability or human improvement claim."
    }
  ],
  "extractionPolicy": "Parse rendered Markdown only, not hidden model assertions. A direct named value or lookup in a labelled candidate table counts explicit. Min/max, ranking, regret and subtraction from displayed inputs count derivable. Omission is not an incorrect assertion. Common fixture/provenance wrapper is identical across conditions; its text alone does not supply numerical answers.",
  "classification": [
    "explicit-correct",
    "derivable-correct",
    "omitted",
    "incorrect",
    "unavailable-or-withheld",
    "generation-rejected"
  ],
  "derivationRules": [
    "From nominal table: max and all equal winners.",
    "From full finite historical matrix: per-row best minus each candidate, maximum regret, minimax ties, pairwise ordering reversals, regret-reduction range across nominal ties.",
    "From nominal yields and explicit robust winner set: sacrifice=max nominal minus each robust yield.",
    "From complete four-row omission table: minimum/maximum sensitivity range.",
    "From explicit candidate regret table: minimum regrets and gain can be derived if all relevant candidate rows exist."
  ],
  "scoring": "Report counts per question and condition over six complete cases (48 fact opportunities). Count direct and derivable coverage separately; show incorrect claims and operational failures. Incomplete/direct-contract cases are separate diagnostics, excluded from the48-denominator. No weighted usefulness score, significance test, user-time or human-performance claim.",
  "numericTolerance": 0.011,
  "tieToleranceKWh": 1e-06,
  "limits": [
    "Synthetic arithmetic fixtures, not new PV/weather experiments.",
    "Displayed2decimal numbers assessed within0.011kWh to accommodate current formatting; no near-tolerance cases.",
    "Raw tables may retain identical derivable information to a narrative report; no numerical superiority over that control is assumed.",
    "Report length is descriptive only, not reading time or cognitive load.",
    "The existing renderer normally receives complete producer output; incomplete and stale-cache cases are contract stress tests."
  ],
  "realCase": "One separately labelled previously inspected Sheffield transfer example from study01. It is not a new independent replication and is excluded from synthetic benchmark percentages.",
  "iterationPolicy": "Preserve primary current-renderer outputs before changes. If defects/gaps are addressed, add a separately versioned report path and an explicitly exploratory rerun of the same known cases. Such a rerun is regression/development evidence, not independent generalisation.",
  "fixtureAnnotation": "Every synthetic example is explicitly labelled a hand-defined arithmetic fixture, not physics-generated research data. Verbatim production renderer wording is test output, not fixture provenance.",
