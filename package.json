{
  "name": "solar-intelligence-operating-system",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler dev --config dist/server/wrangler.json --local --port 3000",
    "test": "pnpm run test:departments && pnpm run test:science && pnpm run test:research && pnpm run test:assessment && pnpm run test:mission && pnpm run test:visual && pnpm run build && pnpm run test:smoke",
    "test:departments": "node --test tests/departments.test.mjs",
    "test:science": "node --import tsx --test tests/science-core.test.mjs",
    "test:research": "node --import tsx --test tests/research-spine.test.mjs",
    "test:mission": "node --import tsx --test tests/mission-intelligence.test.mjs",
    "test:visual": "node --import tsx --test tests/visual-computing.test.mjs tests/observatory-framework.test.mjs tests/instrument-01-model.test.mjs tests/instrument-02-model.test.mjs tests/instrument-03-model.test.mjs tests/instrument-04-model.test.mjs tests/instrument-05-model.test.mjs tests/instrument-06-model.test.mjs tests/sunlit-observatory.test.mjs",
    "test:smoke": "node --import tsx --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "security:audit": "pnpm audit --audit-level high",
    "db:generate": "drizzle-kit generate",
    "test:assessment": "node --import tsx --test tests/frozen-bundle.test.mjs tests/representative-audit.test.mjs tests/assessment-source.test.mjs tests/reference-export.test.mjs tests/report-benchmark.test.mjs tests/decision-evidence-report.test.mjs tests/assessment-evidence.test.mjs tests/assessment-integration.test.mjs",
    "research:capture": "node --import tsx scripts/research/capture-baseline.mts",
    "research:audit": "node --import tsx scripts/research/run-assessment-audit.mts",
    "research:reference-export": "node --import tsx scripts/research/export-reference-inputs.mts",
    "research:report-benchmark": "node --import tsx scripts/research/run-report-benchmark.mts",
    "research:report-exploration": "node --import tsx scripts/research/run-report-exploration.mts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@react-three/postprocessing": "3.0.4",
    "drizzle-orm": "0.45.2",
    "gsap": "3.15.0",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.48.0",
    "@cloudflare/workers-types": "5.20260722.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.6",
    "wrangler": "4.115.0"
  },
  "type": "module"
}
